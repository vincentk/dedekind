# Rule 1: no state outlives a call.  A lambda that captures by reference and
# escapes its function carries a reference to a local or a parameter out of
# the call.  A by-reference capture leaves a reference-typed field in the
# closure class, visible only with implicit nodes, hence the traversal.
# Escape is approximated: inside a return, not under a synchronous consumer
# (std::visit, std::invoke, std::apply, a std::ranges algorithm; not a view
# adaptor or a wrapper such as std::make_pair, which store the closure), and not called on the spot (also as a dependent call
# inside a template).  It misses a lambda
# stored into a member or global outside a return, and would flag a returned
# lambda that a non-std function calls at once.
set traversal AsIs
match lambdaExpr(has(cxxRecordDecl(isLambda(), has(fieldDecl(hasType(referenceType()))))), hasAncestor(returnStmt()), unless(hasAncestor(callExpr(callee(functionDecl(matchesName("^::std::(visit|invoke|apply)$|^::std::ranges::__[a-z_]+(::__fn)?::operator\(\)$")))))), unless(hasAncestor(cxxOperatorCallExpr(hasOverloadedOperatorName("()"), hasArgument(0, ignoringImplicit(lambdaExpr()))))), unless(hasAncestor(callExpr(callee(expr(ignoringParenImpCasts(lambdaExpr())))))), isExpansionInMainFile(), hasAncestor(scope))
