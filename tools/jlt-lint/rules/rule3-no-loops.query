# grade: Π, rejecting: a finding refutes translatability by Table 7's rows; silence affirms nothing.
# Rule 3: a loop is a fold only when its end is stated before it starts (Table
# 7: a counted for, or a range-for over a sized range, read as fold_left over
# iota(0uz, n) or over the range, its locals the state; Meyer and Ritchie
# 1967, the LOOP language, whose count is fixed on entry).  Every other loop
# is a finding: a while, a do, a for that is not counted, a range-for over
# anything but an array.  Conservative: a jump in a nested statement or a
# closure counts, a non-const local bound and a sized range other than an
# array do not pass.  AsIs, because the counter's type in the comparison is
# read off its implicit casts, which only this traversal shows; a loop is
# judged once, as written, not in each instantiation of its template.
set traversal AsIs

# The counter: one integer variable, initialised in the loop's head.
let counter varDecl(hasType(isInteger()), hasInitializer(anything())).bind("i")
let theCounter declRefExpr(to(varDecl(equalsBoundNode("i"))))
let counterOrBound declRefExpr(to(varDecl(anyOf(equalsBoundNode("i"), equalsBoundNode("n")))))

# The bound, known at entry: a literal, a parameter, a const variable, or the
# size of a std::array.
let bound anyOf(integerLiteral(),
    declRefExpr(to(varDecl(anyOf(parmVarDecl(), hasType(isConstQualified()))).bind("n"))),
    cxxMemberCallExpr(callee(cxxMethodDecl(hasName("size"), ofClass(hasName("::std::array"))))))

# counter < bound, compared in the counter's own type: the counter is read,
# not converted, so the bound is representable and ++ reaches it.
let condition binaryOperator(hasOperatorName("<"),
    hasLHS(ignoringParens(implicitCastExpr(hasCastKind("CK_LValueToRValue"),
        hasSourceExpression(ignoringParens(theCounter))))),
    hasRHS(ignoringParenImpCasts(bound)))

let increment unaryOperator(hasOperatorName("++"), hasUnaryOperand(ignoringParenImpCasts(theCounter)))

# What the body may not do: jump out, or write the counter or the bound,
# directly or through a second name (a reference, an address, a non-const
# reference argument, a lambda's capture).
let jump stmt(anyOf(breakStmt(), returnStmt(), gotoStmt()))
let forbidden stmt(anyOf(breakStmt(), returnStmt(), gotoStmt(),
    binaryOperator(isAssignmentOperator(), hasLHS(ignoringParenImpCasts(counterOrBound))),
    unaryOperator(hasAnyOperatorName("++", "--"), hasUnaryOperand(ignoringParenImpCasts(counterOrBound))),
    unaryOperator(hasOperatorName("&"), hasUnaryOperand(ignoringParenImpCasts(counterOrBound))),
    callExpr(forEachArgumentWithParam(ignoringParenImpCasts(counterOrBound),
        parmVarDecl(hasType(referenceType(unless(pointee(isConstQualified()))))))),
    lambdaExpr(hasAnyCapture(capturesVar(varDecl(anyOf(equalsBoundNode("i"), equalsBoundNode("n"))))))))
let alias varDecl(hasType(referenceType()), hasInitializer(ignoringParenImpCasts(counterOrBound)))

let counted forStmt(hasLoopInit(declStmt(hasSingleDecl(counter))),
    hasCondition(condition), hasIncrement(increment),
    hasBody(allOf(unless(forbidden), unless(hasDescendant(forbidden)), unless(hasDescendant(alias)))))

# A range-for over an array or a std::array, whose size is its type's.
let sized cxxForRangeStmt(
    hasRangeInit(ignoringParenImpCasts(expr(hasType(hasUnqualifiedDesugaredType(anyOf(
        constantArrayType(),
        recordType(hasDeclaration(classTemplateSpecializationDecl(hasName("::std::array")))))))))),
    hasBody(allOf(unless(jump), unless(hasDescendant(jump)))))

match stmt(isExpansionInMainFile(), unless(isInTemplateInstantiation()),
    anyOf(whileStmt(), doStmt(), forStmt(unless(counted)), cxxForRangeStmt(unless(sized))),
    hasAncestor(scope))
