# Rule 1: values are passed by value or by const reference.  A forwarding
# reference (T&& or auto&& on a template type parameter) is perfect
# forwarding, an idiom the posture does not admit: it binds lvalues as
# mutable references.  Counted apart from the mutation channel.
match parmVarDecl(hasType(hasCanonicalType(rValueReferenceType())), hasType(hasCanonicalType(references(qualType(templateTypeParmType(), unless(isConstQualified()))))), hasDeclContext(functionDecl(unless(cxxMethodDecl(ofClass(cxxRecordDecl(isLambda())))))), isExpansionInMainFile(), hasAncestor(scope))
