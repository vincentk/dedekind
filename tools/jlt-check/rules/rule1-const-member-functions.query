# Rule 1: values do not change.  Every member function is const (or
# static): a non-const one changes its object.  Exempt: constructors,
# destructors, defaulted and deleted members, lambdas, and the standard
# iterator protocol (a nested iterator or sentinel).
match cxxMethodDecl(unless(anyOf(isConst(), isStaticStorageClass(), cxxConstructorDecl(), cxxDestructorDecl(), isImplicit(), isDefaulted(), isDeleted(), ofClass(cxxRecordDecl(isLambda())), ofClass(cxxRecordDecl(matchesName("(iterator|sentinel)$"))))), isExpansionInMainFile(), hasAncestor(scope))
