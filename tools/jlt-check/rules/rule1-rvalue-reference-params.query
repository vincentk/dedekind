# Rule 1: values are passed by value or by const reference.  An rvalue
# reference to a non-const type that is not a forwarding reference (a
# concrete type, or a class template's parameter) is a move sink.
match parmVarDecl(hasType(hasCanonicalType(rValueReferenceType())), hasType(hasCanonicalType(references(qualType(unless(isConstQualified()))))), unless(allOf(hasType(hasCanonicalType(references(qualType(templateTypeParmType(), unless(isConstQualified()))))), hasType(hasCanonicalType(rValueReferenceType())), unless(hasType(rValueReferenceType(pointee(templateTypeParmType(hasDeclaration(templateTypeParmDecl(hasDeclContext(cxxRecordDecl())))))))))), hasDeclContext(functionDecl(unless(cxxMethodDecl(ofClass(cxxRecordDecl(isLambda())))))), isExpansionInMainFile(), hasAncestor(scope))
